# Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
# Use a chave secreta (sb_secret_... / service_role). Ela só deve existir no backend.
SUPABASE_KEY=sua_chave_secreta_do_supabase

PORT=3001

# Segredo usado para assinar os tokens JWT (texto longo e aleatório).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Origens permitidas no CORS, separadas por vírgula. Vazio = qualquer origem.
CORS_ORIGIN=http://localhost:5173,https://plataforma-energia-renovavel.vercel.app
